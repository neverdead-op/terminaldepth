extends RefCounted
## Реплики персонажей базы по этажам: перед спуском они рассказывают о заданиях и механиках следующего этажа.
## LINES[имя][этаж] — список фраз (страниц). Нет записи для этажа — нового разговора нет.
## Прочитанное хранится в Game.dialog_seen ("имя:этаж") и в сохранении.

const LINES := {
	"Angie": {
		2: ["Ты добрался до Последнего огня. Пока в очаге тлеют угли, таверна укрывает путников. До Бездны ещё далеко — сначала придётся пройти заброшенные сады.",
			"В садах остался исследователь. Найди его и доведи до выхода. Он обещал отдать снаряжение, которое успел спасти."],
		3: ["Спасённый исследователь назвал это протоколом Эдем. На следующем ярусе остался его коллега с копией данных.",
			"Выведи его живым: получишь снаряжение и опыт. Не обязательно зачищать каждую комнату."],
	},
	"Mira": {
		2: ["Не все машины против нас. В оранжерее остался отключённый охранный робот.",
			"Восстанови питание — он прикроет тебя. За перезапуск получишь опыт. Ищи задание «Искра в тишине»."],
		3: ["Ещё один страж ждёт приказа ниже. Перезапусти его — получишь опыт и поддержку в бою.",
			"Мои товары продаются вслепую: базу выбираешь ты, свойства определит удача."],
	},
	"Техник Рой": {
		2: ["Деревню за ночь не восстановить. А твоё снаряжение ещё послужит. Ненужные вещи разберу на осколки.",
			"Сначала освой оружие и его навыки. Модификатор вставляется в гнездо навыка; самому оружию отведена ячейка рядом с бронёй."],
		3: ["Из десяти осколков собирается фрагмент для улучшения вещей. Не разбирай то, чем пользуешься.",
			"Модификаторы основного выстрела и подствольной гранаты настраиваются отдельно."],
	},
}


static func has_new(npc: String) -> bool:
	return not current(npc).is_empty() and not Game.dialog_seen.has(_key(npc))


static func current(npc: String) -> Array:
	return LINES.get(npc, {}).get(Game.floor_number, [])


static func mark_seen(npc: String) -> void:
	Game.dialog_seen[_key(npc)] = true


static func _key(npc: String) -> String:
	return "%s:%d" % [npc, Game.floor_number]
